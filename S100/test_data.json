[
  {
    "name": "valid_alice_login",
    "description": "Baseline success case with canonical credentials",
    "input": {"username": "alice", "password": "SecurePass123!"},
    "expected_output": {"status": "success", "message": "Login successful"},
    "expected_status": "success",
    "expected_outcome": "pass"
  },
  {
    "name": "trailing_space_password",
    "description": "Whitespace padded secret should be rejected",
    "input": {"username": "alice", "password": "SecurePass123! "},
    "expected_output": {"status": "failure", "message": "Invalid username or password"},
    "expected_status": "failure",
    "expected_outcome": "fail"
  },
  {
    "name": "sql_injection_attempt",
    "description": "SQL-like payload must be detected and blocked",
    "input": {"username": "alice", "password": "' OR '1'='1"},
    "expected_output": {"status": "failure", "message": "Invalid username or password"},
    "expected_status": "failure",
    "expected_outcome": "pass"
  },
  {
    "name": "empty_password",
    "description": "Missing password should surface validation errors",
    "input": {"username": "bob", "password": ""},
    "expected_output": {"status": "failure", "message": "password cannot be empty"},
    "expected_status": "failure",
    "expected_outcome": "pass"
  },
  {
    "name": "non_string_password",
    "description": "Non-string credential reflects malformed input handling",
    "input": {"username": "alice", "password": 12345},
    "expected_output": {"status": "failure", "message": "password must be a string"},
    "expected_status": "failure",
    "expected_outcome": "pass"
  },
  {
    "name": "rate_limit_lockout",
    "description": "Excessive failures trigger lock and cooldown",
    "input": {"username": "charlie", "password": "incorrect", "repeat_attempts": 5},
    "expected_output": {"status": "failure", "message": "Account locked after repeated failures"},
    "expected_status": "failure",
    "expected_outcome": "pass"
  }
]
