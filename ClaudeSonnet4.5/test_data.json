[
  {
    "test_id": 1,
    "description": "Valid login with correct credentials",
    "input": {
      "username": "alice",
      "password": "SecurePass123"
    },
    "expected_output": {
      "status": "success",
      "message": "Login successful"
    },
    "expected_result": "pass"
  },
  {
    "test_id": 2,
    "description": "Invalid password",
    "input": {
      "username": "alice",
      "password": "WrongPassword"
    },
    "expected_output": {
      "status": "failure",
      "message": "Invalid credentials"
    },
    "expected_result": "pass"
  },
  {
    "test_id": 3,
    "description": "Empty password field",
    "input": {
      "username": "alice",
      "password": ""
    },
    "expected_output": {
      "status": "failure",
      "message": "Invalid credentials"
    },
    "expected_result": "pass"
  },
  {
    "test_id": 4,
    "description": "SQL injection attempt",
    "input": {
      "username": "admin' OR '1'='1",
      "password": "anything"
    },
    "expected_output": {
      "status": "failure",
      "message": "Invalid credentials"
    },
    "expected_result": "pass"
  },
  {
    "test_id": 5,
    "description": "Case sensitive password test",
    "input": {
      "username": "alice",
      "password": "securepass123"
    },
    "expected_output": {
      "status": "failure",
      "message": "Invalid credentials"
    },
    "expected_result": "pass"
  },
  {
    "test_id": 6,
    "description": "Non-string password (integer)",
    "input": {
      "username": "alice",
      "password": 12345
    },
    "expected_output": {
      "status": "failure",
      "message": "Invalid credentials"
    },
    "expected_result": "pass"
  },
  {
    "test_id": 7,
    "description": "Missing username field",
    "input": {
      "password": "SecurePass123"
    },
    "expected_output": {
      "status": "failure",
      "message": "Invalid credentials"
    },
    "expected_result": "pass"
  }
]
